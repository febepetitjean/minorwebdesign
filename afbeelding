<!DOCTYPE html>
<html lang="nl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Burgers & Fries</title>
<style>
  html, body {
    margin: 0;
    height: 100%;
    background: #000;
    overflow: hidden;
  }

  /* 16:9 vlak dat altijd in het scherm past */
  .stage {
    position: relative;
    width: min(100vw, calc(100vh * 16 / 9));
    aspect-ratio: 16 / 9;
    margin: 0 auto;
    top: 50%;
    transform: translateY(-50%);
    cursor: pointer;
    user-select: none;
  }

  .stage img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    pointer-events: none;
  }

  /* 1. geel scherm = standaard */
  /* 2. rood scherm verschijnt bij hover */
  .red {
    opacity: 0;
    transition: opacity 0.6s ease;
  }
  .stage:hover .red {
    opacity: 1;
  }

  /* 3. kleine foto's: uitgesneden uit WEBDESIGN-05 */
  .photo {
    opacity: 0;
    transition: opacity 0.5s ease;
  }
  .photo.show {
    opacity: 1;
  }
  .p1 { clip-path: inset(21.9% 70.7% 20.6% 5.1%); }
  .p2 { clip-path: inset(21.9% 37.9% 20.6% 37.9%); }
  .p3 { clip-path: inset(21.7% 5.1% 20.6% 70.5%); }
</style>
</head>
<body>

<div class="stage" id="stage">
  <img src="WEBDESIGN-04.png" alt="Geel scherm">
  <img src="WEBDESIGN-06.png" alt="Rood scherm" class="red">

  <img src="WEBDESIGN-05.png" alt="Foto 1" class="photo p1">
  <img src="WEBDESIGN-05.png" alt="Foto 2" class="photo p2">
  <img src="WEBDESIGN-05.png" alt="Foto 3" class="photo p3">
</div>

<script>
  const photos = document.querySelectorAll('.photo');
  let count = 0;

  document.getElementById('stage').addEventListener('click', () => {
    if (count < photos.length) {
      photos[count].classList.add('show');   // volgende foto tonen
      count++;
    } else {
      photos.forEach(p => p.classList.remove('show')); // reset na de derde
      count = 0;
    }
  });
</script>

</body>
</html>
