<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Friesfriday</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Jost:ital,wght@1,800&display=swap" rel="stylesheet">
<style>
  :root{--red:#EF2F4E;--yellow:#FFBF31}
  html,body{height:100%;margin:0;overflow:hidden;background:var(--red)}
  #pile{position:absolute;inset:0;overflow:hidden;pointer-events:none;z-index:1}
  #pile .slot{position:absolute}
  #pile .b{position:absolute;background:var(--yellow)}
  /* Logo: an SVG on the original 2576x1449 artboard, so every part sits exactly where it does in the design. */
  #logo{position:absolute;inset:0;width:100%;height:100%;z-index:2;overflow:visible}
  #logo text{
    font-family:"Jost","Futura","Century Gothic","Avenir Next",sans-serif;
    font-style:italic;font-weight:800;font-size:233px;fill:var(--yellow);
  }
  #logo .lb{fill:var(--yellow)}
  .replay{
    position:absolute;z-index:3;top:calc(env(safe-area-inset-top,0px) + 16px);right:16px;
    font:700 14px/1 "Jost","Futura","Century Gothic",sans-serif;
    color:var(--yellow);background:transparent;border:2px solid var(--yellow);
    border-radius:999px;padding:10px 18px;cursor:pointer;
  }
  .replay:hover{background:var(--yellow);color:var(--red)}
  .replay:focus-visible{outline:3px solid #fff;outline-offset:3px}
</style>
</head>
<body>
  <div id="pile" aria-hidden="true"></div>
  <svg id="logo" viewBox="0 0 2576 1449" preserveAspectRatio="xMidYMid meet" role="img" aria-label="Friesfriday">
    <text x="480"  y="774" textLength="297" lengthAdjust="spacingAndGlyphs">FR</text>
    <text x="879"  y="774" textLength="593" lengthAdjust="spacingAndGlyphs">ESFR</text>
    <text x="1575" y="774" textLength="513" lengthAdjust="spacingAndGlyphs">DAY</text>
    <polygon class="lb" points="886,328 938,330 847,774 795,774"/>
    <polygon class="lb" points="1581,328 1633,330 1542,774 1490,774"/>
  </svg>
  <button class="replay" type="button">Replay</button>

<script>
(function(){
  var SKEW = -11.5;
  var LAYERS = 4, PITCH = 9.5, LAYER_STEP = 1.9, BASE = 2.4;   // in "u" (1u = 1% of logo width)
  var L = 17.3, T = 2;
  var reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  var pile = document.getElementById("pile");
  var svg = document.getElementById("logo");
  var logoBars = svg.querySelectorAll(".lb");
  var running = [];
  function rnd(a, b){ return a + Math.random()*(b - a); }

  // Fall, bounce twice, settle exactly at 0 (the original position).
  function dropFrames(fromY, b, tf){
    return [
      {offset:0,   transform:tf(fromY), easing:"cubic-bezier(.55,0,.9,.6)"},
      {offset:.60, transform:tf(0),     easing:"cubic-bezier(.2,.7,.4,1)"},
      {offset:.76, transform:tf(-b),    easing:"cubic-bezier(.6,0,.9,.5)"},
      {offset:.88, transform:tf(0),     easing:"cubic-bezier(.2,.7,.4,1)"},
      {offset:.94, transform:tf(-b*.26),easing:"cubic-bezier(.6,0,.9,.5)"},
      {offset:1,   transform:tf(0)}
    ];
  }

  function play(){
    running.forEach(function(a){ a.cancel(); });
    running = [];
    pile.innerHTML = "";

    var W = window.innerWidth, H = window.innerHeight;
    var rect = svg.getBoundingClientRect();
    var s = Math.min(rect.width/2576, rect.height/1449);           // px per SVG unit
    var top0 = rect.top + (rect.height - 1449*s)/2;                // screen y of artboard top
    var u = s*25.76;                                               // px per "u"

    // 1) Logo bars: start fully above the screen, land back at translateY(0).
    if(!reduced){
      var from = -(top0 + 774*s)/s - 60;                           // in SVG units
      logoBars.forEach(function(el, k){
        running.push(el.animate(
          dropFrames(from, .035*H/s, function(y){ return "translateY("+y+"px)"; }),
          {duration:1500, delay:k*140, fill:"both"}
        ));
      });
    }

    // 2) Identical bars fall at the same time, settle nearly flat and crisscross.
    var perLayer = Math.ceil(W/(PITCH*u)) + 2;
    var n = 0;
    for(var r = 0; r < LAYERS; r++){
      for(var i = 0; i < perLayer; i++){
        var sign = ((i + r) % 2 === 0) ? 1 : -1;
        var tilt = sign * rnd(7, 17);
        var x = (i*PITCH + (r % 2 ? PITCH/2 : 0) - 8 + rnd(-1.2, 1.2))*u;
        var y = (BASE + r*LAYER_STEP + rnd(-.3, .3))*u;
        var endRot = "rotate("+(90 + tilt)+"deg) skewX("+SKEW+"deg)";

        var slot = document.createElement("div");
        slot.className = "slot";
        slot.style.cssText = "z-index:"+n+";left:"+x+"px;bottom:"+y+"px;width:"+(L*u)+"px;height:"+(T*u)+"px";
        var b = document.createElement("div");
        b.className = "b";
        b.style.cssText = "width:"+(T*u)+"px;height:"+(L*u)+"px;left:"+((L-T)/2*u)+"px;top:"+((T-L)/2*u)+"px;"+
                          "box-shadow:0 0 0 "+(.22*u)+"px #EF2F4E;transform:"+endRot;
        slot.appendChild(b);
        pile.appendChild(slot);

        if(!reduced){
          var delay = 80 + n*45 + rnd(0, 120);
          var dur = 1400 + rnd(0, 300);
          var start = "rotate("+rnd(-14,14).toFixed(1)+"deg) skewX("+SKEW+"deg)";
          running.push(slot.animate(
            dropFrames(-(H + L*u + r*40), .035*H, function(v){ return "translateY("+v+"px)"; }),
            {duration:dur, delay:delay, fill:"both"}
          ));
          running.push(b.animate([
            {offset:0,   transform:start},
            {offset:.30, transform:start, easing:"ease-in-out"},
            {offset:.60, transform:endRot},
            {offset:1,   transform:endRot}
          ],{duration:dur, delay:delay, fill:"both"}));
        }
        n++;
      }
    }
  }

  document.querySelector(".replay").addEventListener("click", play);
  var t; window.addEventListener("resize", function(){ clearTimeout(t); t = setTimeout(play, 250); });
  (document.fonts && document.fonts.ready ? document.fonts.ready : Promise.resolve()).then(play);
})();
</script>
</body>
</html>
