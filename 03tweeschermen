<!DOCTYPE html>
<html lang="nl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Friesfriday – Bestelling #3</title>
<link href="https://fonts.googleapis.com/css2?family=Jost:wght@700;800&display=swap" rel="stylesheet">
<style>
  :root { --rood:#EF2F4E; --geel:#FFBD33; }
  * { margin:0; padding:0; box-sizing:border-box; }
  html, body { height:100%; overflow:hidden; background:var(--rood); }
  body {
    font-family:'Futura','Jost','Century Gothic',sans-serif;
    font-weight:800; text-transform:uppercase;
    -webkit-user-select:none; user-select:none;
    touch-action:pan-y; cursor:pointer;
  }

  /* Gele strook */
  .strook { position:fixed; inset:0; width:100%; height:100%; }
  .strook.portret { display:none; }
  @media (orientation:portrait) {
    .strook.landschap { display:none; }
    .strook.portret { display:block; }
  }

  /* Titel */
  .titel { position:fixed; top:5vh; left:4.5vw; color:var(--geel); line-height:1; }
  .titel h1 { font-size:clamp(28px,4.5vw,64px); font-weight:800; }
  .titel p  { font-size:clamp(14px,1.8vw,26px); margin-top:.3em; }
  @media (orientation:portrait) {
    .titel { left:auto; right:5vw; top:4vh; }
    .titel h1 { font-size:clamp(28px,9vw,64px); }
    .titel p  { font-size:clamp(14px,4vw,26px); }
  }

  /* Logo */
  .logo {
    position:fixed; right:3.5vw; bottom:4vh;
    color:var(--geel); font-size:clamp(28px,5.5vw,90px);
    font-style:italic; font-weight:800; letter-spacing:-.02em; line-height:1;
  }
  @media (orientation:portrait) { .logo { right:auto; left:5vw; font-size:clamp(28px,12vw,90px); } }

  /* Woorden op één horizontale lijn */
  .rij {
    position:fixed; top:50%; left:0; width:100%;
    transform:translateY(-50%); overflow:hidden;
  }
  .spoor { display:flex; transition:transform .6s cubic-bezier(.65,0,.25,1); }
  .woord {
    flex:0 0 100vw; text-align:center; color:var(--rood);
    font-size:clamp(18px,2.2vw,34px); font-weight:800; letter-spacing:.01em;
  }
  @media (orientation:portrait) { .woord { font-size:clamp(20px,6vw,40px); } }

  /* Teller */
  .teller {
    position:fixed; bottom:2vh; left:50%; transform:translateX(-50%);
    color:var(--geel); font-size:14px; opacity:.8; display:none;
  }
</style>
</head>
<body>

<!-- Landschap (computer) -->
<svg class="strook landschap" viewBox="0 0 2011 1178" preserveAspectRatio="xMidYMid slice">
  <polygon points="1253,0 1978,0 773,1178 47,1178" fill="#FFBD33"/>
</svg>
<!-- Portret (gsm) -->
<svg class="strook portret" viewBox="0 0 1080 1920" preserveAspectRatio="xMidYMid slice">
  <polygon points="0,0 1080,1185 1080,1920 0,728" fill="#FFBD33"/>
</svg>

<div class="titel">
  <h1>Bestelling #3</h1>
  <p>De Frietketel, Gent</p>
</div>

<div class="rij"><div class="spoor" id="spoor"></div></div>

<div class="logo">FRIESFRIDAY</div>

<script>
  const woorden = ["Tomatenketchup", "Viandel", "Chickennuggets", "Puntzak"];
  const spoor = document.getElementById("spoor");
  let index = 0;

  woorden.forEach(w => {
    const el = document.createElement("div");
    el.className = "woord";
    el.textContent = w;
    spoor.appendChild(el);
  });

  function toon(nieuw) {
    index = Math.max(0, Math.min(woorden.length - 1, nieuw));
    spoor.style.transform = `translateX(${-index * 100}vw)`;
  }

  // Klikken (muis): links = vorige, rechts = volgende
  // Swipen (touch): naar links = volgende, naar rechts = vorige
  let startX = null;
  window.addEventListener("pointerdown", e => { startX = e.clientX; });
  window.addEventListener("pointerup", e => {
    if (startX === null) return;
    const dx = e.clientX - startX;
    startX = null;
    if (e.pointerType === "mouse") {
      toon(e.clientX > window.innerWidth / 2 ? index + 1 : index - 1);
    } else if (Math.abs(dx) > 40) {
      toon(dx < 0 ? index + 1 : index - 1);
    }
  });

  // Pijltjestoetsen (extra)
  window.addEventListener("keydown", e => {
    if (e.key === "ArrowRight") toon(index + 1);
    if (e.key === "ArrowLeft")  toon(index - 1);
  });

  toon(0);
</script>
</body>
</html>
